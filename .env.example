# ═══════════════════════════════════════════════════════════
#  Variáveis de ambiente — copie para .env (local) e configure
#  as mesmas no dashboard do Vercel (Settings > Environment Variables).
#  NUNCA comite valores reais.
# ═══════════════════════════════════════════════════════════

# -- InfinitePay (Checkout Integrado) --------------------------
# Sua InfiniteTag SEM o "$" do inicio (canto superior esquerdo do app).
# Habilite antes: App > Vendas > Checkout > Configuracoes >
# Habilitar Checkout Integrado.
INFINITEPAY_HANDLE=

# URL publica do site, com https e SEM barra no final.
# Usada para montar o redirect_url e o webhook_url que a InfinitePay
# chama. Se ficar vazia, e deduzida do proprio request (funciona na
# Vercel). Em producao, preencha para nao depender de header.
PUBLIC_BASE_URL=

# ── Pix estático (recebedor) ──────────────────────────────────
# Chave Pix que vai RECEBER o pagamento. Pode ser:
#   e-mail, telefone (+5583...), CPF/CNPJ (só números) ou chave aleatória.
# LEGADO: o Pix agora passa pelo Checkout Integrado (0% e com
# confirmacao automatica). Estas tres variaveis so sao usadas
# por api/_pix.js, que nao esta mais no fluxo. Pode remover
# quando tiver certeza de que nao vai voltar atras.
PIX_KEY=

# Nome do recebedor no comprovante (máx 25 caracteres, sem acento — é sanitizado no servidor).
PIX_MERCHANT_NAME=HAMBURGADA DA CRUZ

# Cidade do recebedor (máx 15 caracteres, sem acento).
PIX_MERCHANT_CITY=JOAO PESSOA

# ── Vercel Postgres (Neon) ────────────────────────────────────
# Preenchidas AUTOMATICAMENTE ao conectar o Storage no projeto Vercel.
# O pacote @vercel/postgres usa POSTGRES_URL por padrão.
# Localmente: rode `vercel env pull .env` para baixar todas.
POSTGRES_URL=
DATABASE_URL=

# ── Painel administrativo (/admin.html) ──────────────────────
# Senha única de acesso ao painel de pedidos. Mínimo 8 caracteres.
# Sem ela o painel devolve 500 e não abre — nunca deixe em branco.
# Gere uma forte, ex.: openssl rand -base64 24
ADMIN_PASSWORD=
