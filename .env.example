# ═══════════════════════════════════════════════════════════
#  Variáveis de ambiente — copie para .env (local) e configure
#  as mesmas no dashboard do Vercel (Settings > Environment Variables).
#  NUNCA comite valores reais.
# ═══════════════════════════════════════════════════════════

# ── Pix estático (recebedor) ──────────────────────────────────
# Chave Pix que vai RECEBER o pagamento. Pode ser:
#   e-mail, telefone (+5583...), CPF/CNPJ (só números) ou chave aleatória.
PIX_KEY=

# Nome do recebedor no comprovante (máx 25 caracteres, sem acento — é sanitizado no servidor).
PIX_MERCHANT_NAME=HAMBURGADA DA CRUZ

# Cidade do recebedor (máx 15 caracteres, sem acento).
PIX_MERCHANT_CITY=JOAO PESSOA

# ── Vercel Postgres (Neon) ────────────────────────────────────
# Preenchidas AUTOMATICAMENTE ao conectar o Storage no projeto Vercel.
# O pacote @vercel/postgres usa POSTGRES_URL por padrão.
# Localmente: rode `vercel env pull .env` para baixar todas.
POSTGRES_URL=
DATABASE_URL=
